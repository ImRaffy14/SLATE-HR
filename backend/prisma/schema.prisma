// =======================================
// GENERATOR & DATASOURCE
// =======================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// =======================================
// ENUMS
// =======================================

enum UserRole {
  ADMIN
  USER
  HR
  MANAGER
  EMPLOYEE
}

enum EnrollmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MaterialType {
  PDF
  FILE
  VIDEO
  YOUTUBE
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum EnrollmentType {
  MANUAL
  AUTO
  SELF
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum TrainingType {
  ONLINE
  ONSITE
  HYBRID
}

enum TrainingStatus {
  DRAFT
  OPEN
  ONGOING
  COMPLETED
  CANCELLED
}

enum TrainingEnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
}

// Succession Planning Enums
enum ReadinessStatus {
  READY_NOW
  READY_6_MONTHS
  READY_1_YEAR
  NOT_READY
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IDPStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum IDPGoalType {
  SHORT_TERM
  LONG_TERM
}

// =======================================
// JOB ROLES
// =======================================

model JobRole {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique // e.g., "Software Developer", "IT Manager", "HR Manager"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees     Employee[]
  criticalRoles CriticalRole[]
  // competencyCategories is stored as jobRoleIds array in CompetencyCategory
}

// =======================================
// USERS (Admins/HR/Managers only)
// =======================================

model User {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  email      String   @unique
  password   String
  role       UserRole
  employeeId String?  @unique @db.ObjectId
  image      Image?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Employee relation
  employee Employee? @relation(fields: [employeeId], references: [id])

  // Competency relations
  createdCompetencies Competency[] @relation("CompetencyCreatedBy")
  updatedCompetencies Competency[] @relation("CompetencyUpdatedBy")

  // Course relations
  createdCourses Course[] @relation("CourseCreatedBy")
  updatedCourses Course[] @relation("CourseUpdatedBy")

  // Succession Planning relations
  potentialRatings       PotentialRating[]
  createdCriticalRoles   CriticalRole[]              @relation("CriticalRoleCreatedBy")
  createdIDPs            IndividualDevelopmentPlan[] @relation("IDPCreatedBy")

  // Training relations
  createdTrainings Training[] @relation("TrainingCreatedBy")
  updatedTrainings Training[] @relation("TrainingUpdatedBy")
}

type Image {
  imageUrl String
  publicId String
}

// =======================================
// EMPLOYEES (from external HR system)
// =======================================

model Employee {
  id         String         @id @default(auto()) @map("_id") @db.ObjectId
  employeeId String         @unique // external HRIS/ERP reference
  name       String
  email      String?
  department String?
  position   String? // Keep for backward compatibility / display
  positionId String?        @db.ObjectId // FK to JobRole
  dateHired  DateTime?
  status     EmployeeStatus @default(ACTIVE)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  jobRole        JobRole?             @relation(fields: [positionId], references: [id])
  user           User?
  competencies   EmployeeCompetency[]
  gapAnalyses    GapAnalysis[]
  enrollments    Enrollment[]
  performance    Performance[]
  CourseFeedback CourseFeedback[]
  trainingEnrollments TrainingEnrollment[]
  trainingCompetencyImpacts TrainingCompetencyImpact[]
  achievementUploads AchievementUpload[]
  notifications  Notification[]
  
  // Succession Planning relations
  talentPools      TalentPool[]
  potentialRatings PotentialRating[]
  idps             IndividualDevelopmentPlan[]

  // Performance Analysis relations
  performanceSnapshots PerformanceSnapshot[]
  aiInsights           AIInsight[]
}

// =======================================
// COMPETENCY MANAGEMENT
// =======================================

model CompetencyCategory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  jobRoleIds  String[] @db.ObjectId // Array of JobRole IDs that this category applies to
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  competencies Competency[]
  // jobRoles are referenced via jobRoleIds array
}

type ProficiencyLevel {
  levelNumber Int // 1-5
  title       String
  definition  String
}

model Competency {
  id          String             @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  categoryId  String             @db.ObjectId
  levels      ProficiencyLevel[]
  weight      Int // 1-100
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  // Audit fields
  createdBy String  @db.ObjectId
  updatedBy String? @db.ObjectId
  creator   User    @relation("CompetencyCreatedBy", fields: [createdBy], references: [id])
  updater   User?   @relation("CompetencyUpdatedBy", fields: [updatedBy], references: [id])

  category             CompetencyCategory       @relation(fields: [categoryId], references: [id])
  employeeCompetencies EmployeeCompetency[]
  gapAnalyses          GapAnalysis[]
  recommendations      TrainingRecommendation[]
  trainingImpacts      TrainingCompetencyImpact[]
  achievementUploads   AchievementUpload[]
  idpGoals             IDPGoal[]
}

model EmployeeCompetency {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId    String   @db.ObjectId
  competencyId  String   @db.ObjectId
  selfRating    Int? // 1-5
  managerRating Int? // 1-5
  finalScore    Float? // calculated: (selfRating * 0.3 + managerRating * 0.7) * weight
  attachments   String[] // array of file URLs
  updatedBy     String?  @db.ObjectId // HR or Manager userId
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee   Employee   @relation(fields: [employeeId], references: [id])
  competency Competency @relation(fields: [competencyId], references: [id])
}

model GapAnalysis {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId      String   @db.ObjectId
  competencyId    String   @db.ObjectId
  requiredLevel   Int // from competency levels
  currentLevel    Int // derived from finalScore
  gap             Int // requiredLevel - currentLevel
  recommendations String[] // array of trainingId strings
  createdAt       DateTime @default(now())

  employee   Employee   @relation(fields: [employeeId], references: [id])
  competency Competency @relation(fields: [competencyId], references: [id])
}

model TrainingRecommendation {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  competencyId    String   @db.ObjectId
  title           String
  description     String?
  link            String?
  difficultyLevel Int // 1-5
  courseId        String?  @db.ObjectId // optional link to Course
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  competency Competency @relation(fields: [competencyId], references: [id])
  course     Course?    @relation(fields: [courseId], references: [id])
}

// =======================================
// LEARNING MANAGEMENT
// =======================================

model CourseCategory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses Course[]
}

model Course {
  id                 String       @id @default(auto()) @map("_id") @db.ObjectId
  courseId           String       @unique
  title              String
  description        String?
  categoryId         String?      @db.ObjectId
  taggedCompetencies String[]     @db.ObjectId // Array of Competency IDs
  status             CourseStatus @default(DRAFT)
  duration           Int // in minutes
  estimatedHours     Int // for learning hours tracking
  isRequired         Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // Audit fields
  createdBy String  @db.ObjectId
  updatedBy String? @db.ObjectId
  creator   User    @relation("CourseCreatedBy", fields: [createdBy], references: [id])
  updater   User?   @relation("CourseUpdatedBy", fields: [updatedBy], references: [id])

  category         CourseCategory?          @relation(fields: [categoryId], references: [id])
  materials        CourseMaterial[]
  quizzes          Quiz[]
  enrollments      Enrollment[]
  feedbacks        CourseFeedback[]
  recommendations  TrainingRecommendation[]
  idpGoals         IDPGoal[]
}

model CourseMaterial {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  courseId    String       @db.ObjectId
  type        MaterialType
  url         String
  title       String
  description String?
  order       Int          @default(0)
  createdAt   DateTime     @default(now())

  course   Course                   @relation(fields: [courseId], references: [id])
  progress EmployeeCourseProgress[]
}

model Quiz {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  courseId     String   @db.ObjectId
  title        String
  description  String?
  totalPoints  Int
  passingScore Int // minimum score to pass (percentage)
  timeLimit    Int? // in minutes, optional
  allowRetake  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course    Course         @relation(fields: [courseId], references: [id])
  questions QuizQuestion[]
  attempts  QuizAttempt[]
}

model QuizQuestion {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  quizId        String       @db.ObjectId
  question      String
  questionType  QuestionType
  points        Int
  order         Int          @default(0)
  choices       Json // Array of { text: String, isCorrect: Boolean }
  correctAnswer String

  quiz Quiz @relation(fields: [quizId], references: [id])
}

model QuizAttempt {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  enrollmentId String   @db.ObjectId
  quizId       String   @db.ObjectId
  answers      Json // Array of { questionId: String, answer: String, isCorrect: Boolean, points: Int }
  score        Float
  totalPoints  Float
  passed       Boolean
  submittedAt  DateTime @default(now())
  locked       Boolean  @default(true)

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])
  quiz       Quiz       @relation(fields: [quizId], references: [id])
}

model Enrollment {
  id                   String           @id @default(auto()) @map("_id") @db.ObjectId
  employeeId           String           @db.ObjectId
  courseId             String           @db.ObjectId
  status               EnrollmentStatus @default(NOT_STARTED)
  progress             Int              @default(0) // legacy, use completionPercentage
  completionPercentage Float            @default(0)
  finalGrade           Float?
  enrollmentType       EnrollmentType   @default(MANUAL)
  isRequired           Boolean          @default(false)
  enrolledAt           DateTime         @default(now())
  completedAt          DateTime?
  failedAt             DateTime?
  lastActivity         DateTime?

  employee        Employee                 @relation(fields: [employeeId], references: [id])
  course          Course                   @relation(fields: [courseId], references: [id])
  quizAttempts    QuizAttempt[]
  progressRecords EmployeeCourseProgress[]
  certificate     Certificate?
}

model EmployeeCourseProgress {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  enrollmentId   String    @db.ObjectId
  materialId     String    @db.ObjectId
  completed      Boolean   @default(false)
  completedAt    DateTime?
  timeSpent      Int       @default(0) // in minutes
  lastAccessedAt DateTime?

  enrollment Enrollment     @relation(fields: [enrollmentId], references: [id])
  material   CourseMaterial @relation(fields: [materialId], references: [id])
}

model Certificate {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  enrollmentId      String    @unique @db.ObjectId
  certificateNumber String    @unique
  pdfUrl            String
  issuedAt          DateTime  @default(now())
  expiresAt         DateTime?

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])
}

model CourseFeedback {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId String   @db.ObjectId
  courseId   String   @db.ObjectId
  rating     Int // 1–5 stars
  comment    String?
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
  course   Course   @relation(fields: [courseId], references: [id])
}

// =======================================
// TRAINING MANAGEMENT
// =======================================

model Venue {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  address     String?
  capacity    Int?
  facilities  String[] // e.g., ["Projector", "WiFi", "Parking"]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trainings Training[]
}

model Trainer {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String?   @unique
  phone       String?
  expertise   String[] // Array of expertise areas
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trainings Training[]
}

model Training {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  trainingId        String         @unique
  title             String
  description       String?
  trainingType       TrainingType
  startDate         DateTime
  endDate           DateTime
  durationHours     Float
  venueId           String?        @db.ObjectId
  trainerId         String?        @db.ObjectId
  trainerName       String?        // Trainer name as text input
  venueName         String?        // Venue name as text input
  meetingLink       String?        // Online meeting link
  address           String?        // Onsite address
  taggedCompetencies String[]      @db.ObjectId // Array of Competency IDs
  maxParticipants   Int
  status            TrainingStatus @default(DRAFT)
  qrCode            String?        // Generated QR code data
  qrCodeExpiresAt   DateTime?      // QR code expiration time
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // Audit fields
  createdBy String  @db.ObjectId
  updatedBy String? @db.ObjectId
  creator   User    @relation("TrainingCreatedBy", fields: [createdBy], references: [id])
  updater   User?   @relation("TrainingUpdatedBy", fields: [updatedBy], references: [id])

  venue              Venue?                    @relation(fields: [venueId], references: [id])
  trainer            Trainer?                  @relation(fields: [trainerId], references: [id])
  enrollments        TrainingEnrollment[]
  competencyImpacts  TrainingCompetencyImpact[]
  idpGoals           IDPGoal[]
}

model TrainingEnrollment {
  id            String                  @id @default(auto()) @map("_id") @db.ObjectId
  trainingId    String                  @db.ObjectId
  employeeId    String                  @db.ObjectId
  status        TrainingEnrollmentStatus @default(PENDING)
  enrollmentType EnrollmentType         @default(SELF) // MANUAL, AUTO, SELF
  approvedBy    String?                 @db.ObjectId // User ID who approved/rejected
  approvedAt    DateTime?
  rejectionReason String?
  enrolledAt    DateTime                @default(now())
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  training   Training            @relation(fields: [trainingId], references: [id])
  employee   Employee            @relation(fields: [employeeId], references: [id])
  attendance TrainingAttendance?
  evaluation TrainingEvaluation?
}

model TrainingAttendance {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  enrollmentId  String          @unique @db.ObjectId
  status        AttendanceStatus @default(ABSENT)
  timeIn        DateTime?
  timeOut       DateTime?
  location      String?         // Optional location data from QR scan
  qrScannedAt   DateTime?       // When QR was scanned
  isLocked      Boolean         @default(false) // Lock after training ends
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  enrollment TrainingEnrollment @relation(fields: [enrollmentId], references: [id])
}

model TrainingEvaluation {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  enrollmentId          String   @unique @db.ObjectId
  trainingRating        Int      // 1-5 rating for training
  trainingComments      String?
  trainerRating          Int?     // 1-5 rating for trainer
  trainerComments       String?
  employeePerformanceRating Int?  // 1-5 rating for employee performance/improvement (by HR/Manager/Trainer)
  employeeImprovementComments String? // Comments about employee's improvement during training
  effectivenessScore    Float?   // Calculated effectiveness score
  submittedAt           DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  enrollment TrainingEnrollment @relation(fields: [enrollmentId], references: [id])
}

model TrainingCompetencyImpact {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  trainingId        String   @db.ObjectId
  employeeId        String   @db.ObjectId
  competencyId      String   @db.ObjectId
  previousLevel     Int      // Level before training
  newLevel          Int      // Level after training
  improvement       Int      // newLevel - previousLevel
  createdAt         DateTime @default(now())

  training   Training   @relation(fields: [trainingId], references: [id])
  employee   Employee   @relation(fields: [employeeId], references: [id])
  competency Competency @relation(fields: [competencyId], references: [id])
}

// =======================================
// SUCCESSION PLANNING
// =======================================

type RequiredCompetency {
  competencyId  String
  requiredLevel Int // 1-5
  weight        Int // percentage weight for scoring (1-100)
}

model CriticalRole {
  id                   String               @id @default(auto()) @map("_id") @db.ObjectId
  jobRoleId            String               @db.ObjectId
  description          String?
  isCritical           Boolean              @default(true)
  requiredCompetencies RequiredCompetency[]
  createdBy            String               @db.ObjectId
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  jobRole    JobRole                     @relation(fields: [jobRoleId], references: [id])
  creator    User                        @relation("CriticalRoleCreatedBy", fields: [createdBy], references: [id])
  talentPool TalentPool[]
  idps       IndividualDevelopmentPlan[]
}

model TalentPool {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  roleId           String          @db.ObjectId
  employeeId       String          @db.ObjectId
  overallScore     Float?
  competencyScore  Float?
  performanceScore Float?
  potentialScore   Float?
  readinessStatus  ReadinessStatus @default(NOT_READY)
  riskLevel        RiskLevel?
  riskFactors      String[]
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  role     CriticalRole @relation(fields: [roleId], references: [id])
  employee Employee     @relation(fields: [employeeId], references: [id])

  @@unique([roleId, employeeId])
}

model PotentialRating {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId String   @db.ObjectId
  rating     Int // 1-5
  comments   String?
  assessedBy String   @db.ObjectId
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
  assessor User     @relation(fields: [assessedBy], references: [id])
}

model IndividualDevelopmentPlan {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  employeeId   String    @db.ObjectId
  targetRoleId String    @db.ObjectId
  status       IDPStatus @default(DRAFT)
  progress     Float     @default(0)
  createdBy    String    @db.ObjectId
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  employee   Employee     @relation(fields: [employeeId], references: [id])
  targetRole CriticalRole @relation(fields: [targetRoleId], references: [id])
  creator    User         @relation("IDPCreatedBy", fields: [createdBy], references: [id])
  goals      IDPGoal[]
}

model IDPGoal {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  idpId        String      @db.ObjectId
  title        String
  description  String?
  goalType     IDPGoalType
  targetDate   DateTime?
  courseId     String?     @db.ObjectId
  trainingId   String?     @db.ObjectId
  competencyId String?     @db.ObjectId
  progress     Float       @default(0)
  completed    Boolean     @default(false)
  completedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  idp        IndividualDevelopmentPlan @relation(fields: [idpId], references: [id], onDelete: Cascade)
  course     Course?                   @relation(fields: [courseId], references: [id])
  training   Training?                 @relation(fields: [trainingId], references: [id])
  competency Competency?               @relation(fields: [competencyId], references: [id])
}

// =======================================
// PERFORMANCE ANALYSIS
// =======================================

model Performance {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId String   @db.ObjectId
  score      Int
  feedback   String?
  reviewDate DateTime @default(now())

  // Audit fields
  createdBy String   @db.ObjectId
  createdAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
}

model PerformanceSnapshot {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId       String   @db.ObjectId
  period           String   // e.g., "2024-Q1", "2024-01"
  performanceScore Float    // from Performance model
  competencyScore  Float    // avg of EmployeeCompetency finalScores
  learningScore    Float    // course completion rate
  trainingScore    Float    // training attendance rate
  overallScore     Float    // weighted average
  createdAt        DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
}

model AIInsight {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId     String   @db.ObjectId
  analysisType   String   // "FULL", "TREND", "RISK", "RECOMMENDATION"
  analysisResult Json     // structured AI output
  promptUsed     String?  // for audit (no PII)
  modelUsed      String   // e.g., "llama-3.3-70b-versatile"
  generatedAt    DateTime @default(now())
  expiresAt      DateTime // cache validity

  employee Employee @relation(fields: [employeeId], references: [id])
}

// =======================================
// EMPLOYEE SELF-SERVICE (ESS)
// =======================================

model AchievementUpload {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId   String   @db.ObjectId
  title        String
  description  String?
  fileUrl      String
  competencyId String?  @db.ObjectId
  status       String   @default("Pending") // Pending | Approved | Rejected
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee  Employee   @relation(fields: [employeeId], references: [id])
  competency Competency? @relation(fields: [competencyId], references: [id])
}

model Notification {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId String   @db.ObjectId
  type       String   // COURSE_DUE, TRAINING_APPROVAL, COMPETENCY_UPDATE, PROMOTION_READY, EVALUATION_REMINDER
  message    String
  isRead     Boolean  @default(false)
  metadata   Json?    // Additional context (courseId, trainingId, etc.)
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
}
