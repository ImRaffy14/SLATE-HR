### ============================================
### COMPETENCY CATEGORY ENDPOINTS
### ============================================

### Create Competency Category (HR/Admin only)
### Note: First create JobRoles, then use their IDs in jobRoleIds array
POST {{baseUrl}}/competency-category/create
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "name": "Technical Skills",
    "description": "Technical and programming competencies",
    "jobRoleIds": ["job_role_id_1", "job_role_id_2", "job_role_id_3"]
}

### Get All Categories
GET {{baseUrl}}/competency-category/list
Content-Type: application/json
Authorization: Bearer {{token}}

### Get Categories by Job Role ID (filter)
GET {{baseUrl}}/competency-category/list?jobRoleId=job_role_id_here
Content-Type: application/json
Authorization: Bearer {{token}}

### Get Categories by Employee ID (auto-filter by employee's position)
GET {{baseUrl}}/competency-category/list?employeeId={{employeeId}}
Content-Type: application/json
Authorization: Bearer {{token}}

### Get Category by ID
GET {{baseUrl}}/competency-category/{{categoryId}}
Content-Type: application/json
Authorization: Bearer {{token}}

### Update Category (HR/Admin only)
PUT {{baseUrl}}/competency-category/update/{{categoryId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "name": "Technical Skills Updated",
    "description": "Updated description for technical skills",
    "jobRoleIds": ["job_role_id_1", "job_role_id_2", "job_role_id_3", "job_role_id_4"]
}

### Delete Category (HR/Admin only)
DELETE {{baseUrl}}/competency-category/delete/{{categoryId}}
Content-Type: application/json
Authorization: Bearer {{token}}

### ============================================
### COMPETENCY ENDPOINTS
### ============================================

### Create Competency (HR/Admin only)
POST {{baseUrl}}/competency/create
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "name": "JavaScript Programming",
    "description": "Ability to write and maintain JavaScript code",
    "categoryId": "{{categoryId}}",
    "weight": 80,
    "levels": [
        {
            "levelNumber": 1,
            "title": "Beginner",
            "definition": "Basic understanding of JavaScript syntax"
        },
        {
            "levelNumber": 2,
            "title": "Intermediate",
            "definition": "Can write functions and work with arrays/objects"
        },
        {
            "levelNumber": 3,
            "title": "Advanced",
            "definition": "Proficient with async/await, promises, and ES6+ features"
        },
        {
            "levelNumber": 4,
            "title": "Expert",
            "definition": "Can architect complex applications and optimize performance"
        },
        {
            "levelNumber": 5,
            "title": "Master",
            "definition": "Industry expert, can mentor others and contribute to language evolution"
        }
    ]
}

